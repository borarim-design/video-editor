{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".parity",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["scripts/parity.ts", "src/lib/layout.ts", "src/types.ts"]
}
